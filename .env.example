# Copy this file to .env locally (or set these as Environment Variables
# in your host's dashboard, e.g. Render → Settings → Environment).
# Nothing here is required to run the app — without keys the engine
# still works using heuristic-only analysis (AI panel will say so).

# Groq (tried first — fast + free tier). Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (used as fallback if Groq is missing/unavailable). Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional — shown in the UI footer / exported reports
CASE_ORG_NAME=SIH26106 - Email Threat Intelligence Unit

# Lock CORS to your frontend's exact URL once deployed, e.g.:
# ALLOWED_ORIGIN=https://yoursite.profreehost.com
ALLOWED_ORIGIN=*

# Flask (Render/most hosts set PORT for you automatically — leave FLASK_PORT as local fallback)
FLASK_PORT=5000
FLASK_DEBUG=False
